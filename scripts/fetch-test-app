#!/usr/bin/env bash
# Downloads the pinned dfinity/internet-identity-test-app release into .test-app/.
#
# The test app is a relying party used by the e2e tests and deployed to mainnet
# alongside II. It is built in its own repository; this script fetches the
# release assets of the tag pinned in .github/versions/test-app:
#
#   .test-app/test_app.wasm   the canister module
#   .test-app/test_app.did    the Candid interface
#   .test-app/dist/           the frontend, loaded as an unpacked Chrome
#                             extension by the Playwright e2e
#
# Assets are verified against the SHA256SUMS file published by the same release.
# That detects a corrupted or truncated download; the pinned tag is the trust
# anchor for *which* build is used.
#
# Re-running is cheap: a stamp file records the tag that is currently unpacked
# and the download is skipped when it already matches.

set -euo pipefail

SCRIPTS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPTS_DIR/.."

REPO="dfinity/internet-identity-test-app"
VERSION_FILE=".github/versions/test-app"
DEST=".test-app"
STAMP="$DEST/.version"
ASSETS=(test_app.wasm test_app.did test_app_dist.tar.gz SHA256SUMS)

tag=$(tr -d '[:space:]' < "$VERSION_FILE")
if [ -z "$tag" ]; then
  echo "no tag pinned in $VERSION_FILE" >&2
  exit 1
fi

if [ "$(cat "$STAMP" 2>/dev/null || true)" = "$tag" ] \
  && [ -f "$DEST/test_app.wasm" ] \
  && [ -f "$DEST/test_app.did" ] \
  && [ -f "$DEST/dist/manifest.json" ]; then
  echo "test app $tag already present in $DEST"
  exit 0
fi

if ! command -v gh > /dev/null; then
  echo "missing the 'gh' CLI, needed to download $REPO releases" >&2
  exit 1
fi

# macOS ships shasum rather than sha256sum; both read the sha256sum format.
verify_checksums() {
  if command -v sha256sum > /dev/null; then
    sha256sum -c SHA256SUMS
  else
    shasum -a 256 -c SHA256SUMS
  fi
}

rm -rf "$DEST"
mkdir -p "$DEST"

echo "downloading $REPO release $tag"
download_args=()
for asset in "${ASSETS[@]}"; do
  download_args+=(--pattern "$asset")
done

# Each asset is a separate request, so a transient network or API failure can
# leave the set incomplete. Retry the whole download before giving up.
#
# The output is captured so a permission failure can be reported with its cause
# rather than gh's bare "release not found".
attempts=3
downloaded=
for attempt in $(seq "$attempts"); do
  if download_log=$(gh release download "$tag" \
    --repo "$REPO" \
    --dir "$DEST" \
    --clobber \
    "${download_args[@]}" 2>&1); then
    downloaded=yes
    break
  fi
  if [ "$attempt" -lt "$attempts" ]; then
    echo "download attempt $attempt of $attempts failed, retrying" >&2
    sleep $((attempt * 5))
  fi
done

if [ -z "$downloaded" ]; then
  echo "$download_log" >&2
  echo >&2
  case "$download_log" in
    *"release not found"* | *"Not Found"* | *"HTTP 404"* | *"HTTP 401"* | *"HTTP 403"*)
      cat >&2 << EOF
Could not read release '$tag' of
  $REPO

That repository is internal, so reading its releases needs a token belonging to
an organisation member:
  - In CI, .github/actions/fetch-test-app takes one as its 'token' input,
    supplied from the GIX_BOT_PAT secret. A pull request from a fork gets no
    secrets at all, so this cannot succeed there until the artifact repository
    is public.
  - Locally, run 'gh auth login' with an account that can see it, or export
    GH_TOKEN.

If the tag is simply not published yet, release it there first, or pin an
existing tag in $VERSION_FILE.
EOF
      ;;
  esac
  exit 1
fi
echo "$download_log"

(
  cd "$DEST"
  verify_checksums
  tar xzf test_app_dist.tar.gz
  rm test_app_dist.tar.gz
)

test -f "$DEST/dist/manifest.json" \
  || { echo "$DEST/dist/manifest.json missing after unpacking the frontend" >&2; exit 1; }

echo "$tag" > "$STAMP"
echo "test app $tag unpacked into $DEST"
