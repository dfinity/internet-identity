#!/usr/bin/env bash
set -euo pipefail

# Deploy the test app canister from a pull request's CI build.
#
# The release pipeline installs the test app only on `refs/tags/release-*`
# (see the `deploy` job in .github/workflows/canister-tests.yml), so there is
# otherwise no way to try a PR's test-app changes against a real canister. The
# artifact itself is always there: `test-app-build` runs on every PR and
# uploads `test_app.wasm`. This script downloads that artifact and installs it.
#
# Deliberately separate from `deploy-pr-to-beta`, which is shaped around the II
# frontend/backend pair: a staging A-D matrix, candid init args, DoH/anchor
# configuration, and reachability/consistency checks against an II deployment.
# The test app shares none of that — it takes no install args here (an upgrade
# does not re-run `init`) and has a single canister per environment. Folding it
# into that script would mean threading a third "end" through all of it.
#
# Usage:
#   scripts/deploy-test-app [options] <PR_NUMBER>
#   scripts/deploy-test-app [options] --run-id <RUN_ID>

readonly DEFAULT_TEST_APP_ID="vt36r-2qaaa-aaaad-aad5a-cai"
readonly ARTIFACT_NAME="test_app.wasm"
readonly JOB_NAME="test-app-build"
readonly WORKFLOW_FILE="canister-tests.yml"
readonly REPO="dfinity/internet-identity"

SCRIPTS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$SCRIPTS_DIR/.."
cd "$ROOT_DIR"

# Sourced for PROXY_CANISTER_ID / IC_NETWORK and the confirm/URL/module-hash
# helpers. DRY_RUN is set first because helpers in there read it under `set -u`.
DRY_RUN=false
# shellcheck source=deploy-common.bash
source "$SCRIPTS_DIR/deploy-common.bash"

print_usage() {
    cat <<EOF
Usage:
  $0 [options] <PR_NUMBER>
  $0 [options] --run-id <RUN_ID>

Downloads the \`$ARTIFACT_NAME\` artifact built by the \`$JOB_NAME\` job of
$WORKFLOW_FILE and installs it on the test app canister.

Options:
  --canister <id>   Target canister (default: $DEFAULT_TEST_APP_ID, mainnet).
  --run-id <id>     Use a specific workflow run instead of resolving from a PR.
  --dry-run         Print the install command without running it.
  --yes             Skip the confirmation prompt (for non-interactive use).
  -h, --help        Show this help.

The default target is the shared mainnet testing app. It is listed in the dapps
explorer and used as a \`derivationOrigin\` in docs/vc-spec.md, so a deploy
there affects anyone else testing against it, and the next release tag will
overwrite it. Pass --canister to target your own instead.
EOF
}

PR_NUMBER=""
RUN_ID=""
CANISTER_ID="$DEFAULT_TEST_APP_ID"
ASSUME_YES=false
STALE_RUN=false

while [ $# -gt 0 ]; do
    case "$1" in
        --canister) CANISTER_ID="${2:-}"; shift 2 ;;
        --run-id)   RUN_ID="${2:-}"; shift 2 ;;
        --dry-run)  DRY_RUN=true; shift ;;
        --yes)      ASSUME_YES=true; shift ;;
        -h|--help)  print_usage; exit 0 ;;
        -*)         echo "Error: unknown option '$1'" >&2; print_usage >&2; exit 1 ;;
        *)
            if [ -n "$PR_NUMBER" ]; then
                echo "Error: unexpected extra argument '$1'" >&2
                exit 1
            fi
            PR_NUMBER="$1"; shift ;;
    esac
done

if [ -z "$CANISTER_ID" ]; then
    echo "Error: --canister requires a canister id" >&2
    exit 1
fi
if [ -n "$PR_NUMBER" ] && [ -n "$RUN_ID" ]; then
    echo "Error: pass either <PR_NUMBER> or --run-id, not both" >&2
    exit 1
fi
if [ -z "$PR_NUMBER" ] && [ -z "$RUN_ID" ]; then
    echo "Error: a <PR_NUMBER> or --run-id is required" >&2
    print_usage >&2
    exit 1
fi
if [ -n "$PR_NUMBER" ] && ! [[ "$PR_NUMBER" =~ ^[0-9]+$ ]]; then
    echo "Error: PR number must be numeric, got '$PR_NUMBER'" >&2
    exit 1
fi

for tool in gh jq curl unzip icp; do
    if ! command -v "$tool" >/dev/null 2>&1; then
        echo "Error: '$tool' not found on PATH." >&2
        exit 1
    fi
done

GITHUB_TOKEN="$(gh auth token)"
if [ -z "$GITHUB_TOKEN" ]; then
    echo "Error: gh CLI is not authenticated." >&2
    exit 1
fi
AUTH_HEADER="Authorization: token $GITHUB_TOKEN"

ARTIFACT_DIR=$(mktemp -d -t ii-deploy-test-app.XXXXXX)
cleanup() {
    if [ -n "${ARTIFACT_DIR:-}" ] && [ -d "$ARTIFACT_DIR" ]; then
        rm -rf "$ARTIFACT_DIR"
    fi
}
trap cleanup EXIT

# -------------------------
# Resolve the workflow run
# -------------------------
if [ -z "$RUN_ID" ]; then
    echo "Resolving PR #$PR_NUMBER..."
    BRANCH=$(gh pr view "$PR_NUMBER" --repo "$REPO" --json headRefName -q .headRefName)
    if [ -z "$BRANCH" ]; then
        echo "Error: could not resolve a branch for PR #$PR_NUMBER" >&2
        exit 1
    fi
    echo "  PR #$PR_NUMBER → branch '$BRANCH'"

    # canister-tests.yml runs as `pull_request` for non-main branches, so the
    # event is left unfiltered and the workflow is matched by path instead.
    RUN_ID=$(curl -sf -H "$AUTH_HEADER" \
        "https://api.github.com/repos/$REPO/actions/runs?branch=$BRANCH&per_page=100" \
        | jq -r --arg WF "$WORKFLOW_FILE" '
            [.workflow_runs[] | select(.path == (".github/workflows/" + $WF))]
            | sort_by(.run_number) | reverse | .[0].id
        ' || true)
    if [ -z "$RUN_ID" ] || [ "$RUN_ID" = "null" ]; then
        echo "Error: no $WORKFLOW_FILE run found for branch '$BRANCH'" >&2
        exit 1
    fi
fi
echo "  Workflow run: $RUN_ID"
echo "  https://github.com/$REPO/actions/runs/$RUN_ID"

# The newest run for a branch is not necessarily a run of its newest commit —
# CI may still be queued for the latest push, in which case the artifact below
# is a build of older code. Silently deploying that is the trap this check
# exists to prevent.
RUN_SHA=$(curl -sf -H "$AUTH_HEADER" \
    "https://api.github.com/repos/$REPO/actions/runs/$RUN_ID" | jq -r '.head_sha // empty')
if [ -n "$PR_NUMBER" ] && [ -n "$RUN_SHA" ]; then
    HEAD_SHA=$(gh pr view "$PR_NUMBER" --repo "$REPO" --json headRefOid -q .headRefOid)
    if [ -n "$HEAD_SHA" ] && [ "$RUN_SHA" != "$HEAD_SHA" ]; then
        echo ""
        echo "WARNING: this run built ${RUN_SHA:0:9}, but PR #$PR_NUMBER now points at ${HEAD_SHA:0:9}."
        echo "         The artifact predates the PR head — CI for the newest commit may still"
        echo "         be running. Deploying this installs the OLDER build."
        STALE_RUN=true
    fi
fi
echo "  Built from: ${RUN_SHA:-unknown}"

# -------------------------
# Validate the build job before downloading
# -------------------------
JOBS_JSON=$(curl -sf -H "$AUTH_HEADER" \
    "https://api.github.com/repos/$REPO/actions/runs/$RUN_ID/jobs?per_page=100")
JOB_JSON=$(echo "$JOBS_JSON" | jq -c --arg N "$JOB_NAME" \
    '.jobs | map(select(.name == $N)) | .[0] // empty')

if [ -z "$JOB_JSON" ]; then
    echo "Error: no '$JOB_NAME' job in run $RUN_ID." >&2
    echo "Jobs present:" >&2
    echo "$JOBS_JSON" | jq -r '.jobs[] | "  - \(.name) (\(.status)/\(.conclusion))"' >&2
    exit 1
fi

JOB_STATUS=$(echo "$JOB_JSON" | jq -r '.status')
JOB_CONCLUSION=$(echo "$JOB_JSON" | jq -r '.conclusion')
if [ "$JOB_STATUS" != "completed" ]; then
    echo "Error: '$JOB_NAME' has not finished (status: $JOB_STATUS). Wait for it." >&2
    exit 1
fi
if [ "$JOB_CONCLUSION" != "success" ]; then
    echo "Error: '$JOB_NAME' did not succeed (conclusion: $JOB_CONCLUSION)." >&2
    exit 1
fi
echo "  Job '$JOB_NAME': $JOB_CONCLUSION"

# -------------------------
# Download + extract
# -------------------------
# Artifact names collide with what `scripts/build` writes locally, so extract
# into the temp dir rather than the repo root.
ARTIFACT_URL=$(curl -sf -H "$AUTH_HEADER" \
    "https://api.github.com/repos/$REPO/actions/runs/$RUN_ID/artifacts?per_page=100" \
    | jq -r --arg N "$ARTIFACT_NAME" \
        '.artifacts | map(select(.name == $N and (.expired | not))) | .[0].archive_download_url // empty')
if [ -z "$ARTIFACT_URL" ]; then
    echo "Error: artifact '$ARTIFACT_NAME' not found (or expired) in run $RUN_ID." >&2
    exit 1
fi

echo "Downloading $ARTIFACT_NAME..."
ZIP_FILE="$ARTIFACT_DIR/$ARTIFACT_NAME.zip"
curl -sfL -H "$AUTH_HEADER" -o "$ZIP_FILE" "$ARTIFACT_URL"
unzip -o "$ZIP_FILE" -d "$ARTIFACT_DIR" >/dev/null
WASM_PATH="$ARTIFACT_DIR/$ARTIFACT_NAME"
if [ ! -f "$WASM_PATH" ]; then
    echo "Error: extracted file not found: $WASM_PATH" >&2
    exit 1
fi
WASM_SHA=$(shasum -a 256 "$WASM_PATH" | cut -d ' ' -f1)
echo "  Extracted $(wc -c <"$WASM_PATH" | tr -d ' ') bytes, sha256 $WASM_SHA"

# -------------------------
# Install
# -------------------------
# Same reasoning as run_icp_install: a canister with no module on chain needs
# --mode install, an installed one needs --mode upgrade. Never `reinstall`,
# which would wipe state.
ONCHAIN_HASH=$(fetch_onchain_module_hash "$CANISTER_ID")
MODE="upgrade"
if [ -z "$ONCHAIN_HASH" ]; then
    MODE="install"
    echo "  $CANISTER_ID has no Wasm module on chain (per ic-api) — using --mode install."
else
    echo "  On-chain module hash: $ONCHAIN_HASH"
    if [ "$ONCHAIN_HASH" = "0x$WASM_SHA" ] || [ "$ONCHAIN_HASH" = "$WASM_SHA" ]; then
        echo "  Note: this wasm is already what's deployed — the install is a no-op."
    fi
fi

echo ""
echo "=== Deploying test app ==="
echo "  Canister: $CANISTER_ID"
echo "  URL:      $(canister_default_url "$CANISTER_ID")"
echo "  Source:   run $RUN_ID${PR_NUMBER:+ (PR #$PR_NUMBER)}"
echo "  Mode:     $MODE"

cmd=(
    icp canister install "$CANISTER_ID"
        -e "$IC_NETWORK"
        --proxy "$PROXY_CANISTER_ID"
        --mode "$MODE"
        --wasm "$WASM_PATH"
)

if [ "$DRY_RUN" = true ]; then
    echo ""
    echo "[dry-run] Would run:"
    printf '  %q' "${cmd[@]}"; echo
    exit 0
fi

if [ "$CANISTER_ID" = "$DEFAULT_TEST_APP_ID" ]; then
    echo ""
    echo "This is the SHARED MAINNET testing app. Others test against it, and the"
    echo "next release tag will overwrite whatever you install now."
fi

# A stale artifact is confirmed even under --yes: --yes means "don't ask me the
# routine question", not "ship code I didn't build".
if [ "$STALE_RUN" = true ]; then
    echo ""
    confirm_yn "The artifact predates the PR head. Install it anyway?" \
        || { echo "Aborted."; exit 1; }
elif [ "$ASSUME_YES" != true ]; then
    echo ""
    confirm_yn "Install this wasm on $CANISTER_ID?" || { echo "Aborted."; exit 1; }
fi

# Suppresses icp-cli's plaintext-identity warning, matching the CI deploy job.
export ICP_WARNING=-mainnet_plaintext_identity

echo ""
echo "Running icp canister install (--mode $MODE)..."
"${cmd[@]}"
echo ""
echo "Done. $(canister_default_url "$CANISTER_ID")"
