// Implemented by a dApp that sends notifications through Internet Identity.
// II's side is in src/internet_identity/internet_identity.did.

type Notification = record {
    id : text;
    title : text;
    body : text;
    url : opt text;
    created_at : nat64;
};

service : {
    // Called by II's service worker as the user. Must be a query.
    ii_pending_notifications : () -> (vec Notification) query;

    // Called after display, so the dApp can stop serving them.
    ii_notifications_delivered : (ids : vec text) -> ();

    // Only needed for channels that cannot fetch for themselves. II-only caller.
    ii_pending_notifications_batch : (users : vec principal)
        -> (vec record { principal; vec Notification }) query;
};
